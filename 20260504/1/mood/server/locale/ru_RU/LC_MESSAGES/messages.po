msgstr "{username} присоединился к игре"

msgid "{username} left the game"
msgstr "{username} покинул игру"

msgid "{username} added monster {name} with {hp} HP"
msgid_plural "{username} added monster {name} with {hp} HP"
msgstr[0] "{username} добавил монстра {name} с {hp} очком здоровья"
